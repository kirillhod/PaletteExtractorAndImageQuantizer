# Dependencies — the project has none; this guards accidental installs.
node_modules/

# Build/test output. There is no build step; these are future-proof.
dist/
coverage/
.cache/
.nyc_output/
*.tsbuildinfo

# Local temporary files
tmp/
.tmp/
*.tmp
*.bak
*.orig
*.rej
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and secrets
.env
.env.*
!.env.example

# Editors
.vscode/
.idea/
.history/
*.code-workspace

# OS junk
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Lockfiles are intentionally NOT ignored: their appearance means a dependency was
# added by mistake and should be visible in git status.
